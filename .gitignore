# Downloaded and fine-tuned model weights - large, regenerable, never commit
models/*
!models/.gitkeep

# Kaggle dataset files
dataset/

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Hugging Face cache
.cache/
# Secrets - API keys and tokens. NEVER commit these.
.env
.env.*
!.env.example
*.key
secrets.json

# Windows "mark of the web" artifacts created when downloading files in WSL
*:Zone.Identifier
